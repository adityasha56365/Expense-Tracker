{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/transactions/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/budgets/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/analytics/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/ocr/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/forecast/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/users/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/goals/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/recurring/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/premium/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/splits/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/subscriptions/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/import/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
