# Root .gitignore for Expense Tracker (Frontend + Backend)

# ── Environment & Secret Files (CRITICAL - DO NOT COMMIT) ──
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt

# ── Python / Backend ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
.pytest_cache/
.coverage
htmlcov/
*.log

# ── Node / Frontend ──
node_modules/
dist/
dist-ssr/
build/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── System & IDE ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
